package: "com.android.os.statsd.flags"
container: "com.android.os.statsd"

flag {
  name: "logging_rate_limit_enabled"
  namespace: "statsd"
  description: "This flag controls logging rate limit in libstatssocket"
  bug: "375682465"
  is_fixed_read_only: true
}

flag {
  name: "logging_control_enabled"
  namespace: "statsd"
  description: "Enables client logging control in libstatssocket"
  bug: "407064406"
  is_fixed_read_only: true
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}
