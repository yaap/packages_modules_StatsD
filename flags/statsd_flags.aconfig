package: "com.android.os.statsd.flags"
container: "com.android.os.statsd"

flag {
  name: "parallel_pulls"
  namespace: "statsd"
  description: "Whether to enable parallel pulls on alarms."
  bug: "390014362"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "partial_invalid_configs"
  namespace: "statsd"
  description: "Whether to enable partially invalid config"
  bug: "435264546"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "trigger_uprobestats"
  namespace: "statsd"
  description: "Whether to call AUprobestatsClient_startUprobestats."
  bug: "296108553"
  is_fixed_read_only: true
}

flag {
    name: "enable_logging_rate_stats_collection"
    namespace: "statsd"
    description: "Enables atoms logging rate distribution per atom id collection"
    bug: "382574781"
    is_fixed_read_only: true
}

flag {
  name: "keep_value_metric_max_dimension_bucket"
  namespace: "statsd"
  description: "Whether to keep the bucket in ValueMetric when dimension guardrail is hit."
  bug: "408060408"
}

flag {
    name: "use_iouring_socket_listener"
    namespace: "statsd"
    description: "Enables iouring implementation of the statsd"
    bug: "297114355"
}

flag {
    name: "trigger_perfetto"
    namespace: "statsd"
    description: "Trigger perfetto when queue overflow happens"
    bug: "462461710"
}

flag {
    name: "use_wait_for"
    namespace: "statsd"
    description: "Use wait with timeout to check event queue"
    bug: "462461710"
}
